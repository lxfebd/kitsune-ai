# 桌宠运行时数据目录（运行时生成，禁止入仓）
# apps/stage-tamagotchi/.kitsune/ —— 计划投放/评审/裁决目录（i18n 文案指示用户投放 plan JSON 于此）
# apps/stage-tamagotchi/storage/  —— agent-api 写 secrets 凭据、token-usage 写用量统计；storage/secrets 含真实 API key，必须忽略
apps/stage-tamagotchi/.kitsune/
apps/stage-tamagotchi/storage/

# 内部/配置目录（最终决定提交）
# .agents/  -> 提交（技能定义）
# .github/ -> 提交（CI/CD）
# config/ -> 提交（配置模板）

# AI 开发记忆/计划/审计文档（不入仓）
.ai-memory/

# 其他工作目录（不需提交）
kimik3/

# 外部克隆的仓库
open/

# 二进制模型和资源（太大，应该用 LFS 或外部下载）
# 仅忽略仓库根的 resources 与桌面端模型目录；包内 src/resources 源码需提交，不在此规则内
# 注意：apps/stage-tamagotchi/resources 下的 gpt-sovits/workflows 等大型运行时资源不入库；
# 但图标等小型构建必需资源必须提交，否则 CI 构建在解析 icon.png?asset 时会报 UNRESOLVED_IMPORT。
/resources/
apps/stage-tamagotchi/resources/*
!apps/stage-tamagotchi/resources/icon.png
!apps/stage-tamagotchi/resources/icon-512.png
!apps/stage-tamagotchi/resources/icon.svg
!apps/stage-tamagotchi/resources/tray-icon-macos.png

# TTS 瘦身打包暂存区（含 Python egg，不入库）
.slim-staging/

# 环境变量/密钥（禁止入仓；保留 *.example 作为模板）
.env
.env.*
!.env.example

# 死代码备份（可还原，不入库；2026-08-07 overseer m0.5 清理）
_dead_overseer_js_*/

# 一次性调试产物（不提交到仓库）
coverage/
diag-*.mjs
*.diag.mjs
.screenshots/
*_check.png
*_capture.png
capture_screen.ps1
# 冒烟/截图调试产物（2026-09-15/16 桌面联动验证遗留）
smoke-dsh.txt
dsh-executor-smoke.txt
pipeline-shot.png
# 桌面窗口枚举现场调试脚本（一次性生成，不提交；自述 head 产物）
enum-live.mjs

# 内部开发文档（含计划/进度/隐私信息，不入仓）
docs/
# 例外：scenarios 包里的 docs 场景是实际场景代码（imports 截图资产），不是内部文档
!packages/scenarios-stage-tamagotchi-browser/src/scenes/docs/
# 例外：i18n locales 的 docs/ 是文档站 i18n 源文件（index.ts + theme.yaml + versions.yaml），
# 被各语言 src/locales/*/index.ts 以 import './docs' 直接引用，是构建必需输入；
# 不入库会使 CI postinstall 报 UNRESOLVED_IMPORT（Could not resolve './docs'）
!packages/i18n/src/locales/*/docs/
# Rust / napi-rs 构建产物（cargo target 与 .node 二进制，平台特定不入库）
/target/
*.node

# TypeScript 声明产物（tsc -b 生成，可再生成）
dist-types/

# Mellos map runtime viewer lockfiles
.mellos/viewers/

# 扫描缓存（repo-scanner 产物，可再生成；真图在仓库根 pet/.mellos/map.json）
.mellos/repo-scan*.json

# 生成产物与运行时状态
.mellos/html/
.mimosa/

# TS incremental build cache（每次 typecheck/build 重生成）
**/*.tsbuildinfo
